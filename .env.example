# 复制为 .env 后按需修改；.env 不会被提交。
# 数据库连接串支持 PostgreSQL / MySQL / SQLite（见下方注释）。
DATABASE_URL=postgres://knowledgebase:knowledgebase@localhost:5432/knowledgebase

# HTTP 监听地址与端口
APP_HOST=127.0.0.1
APP_PORT=8080

# 启动时是否自动执行数据库迁移（生产环境建议改为 false，由发布流程单独执行）
APP_RUN_MIGRATIONS=true

# 允许的跨域来源，逗号分隔；留空表示允许任意来源（仅建议本地开发）
APP_CORS_ORIGINS=http://localhost:3000

# 单个请求超时时间（秒）
APP_REQUEST_TIMEOUT_SECS=30

# 日志过滤表达式
RUST_LOG=info,knowledgebase_server=debug

# 其他数据库示例：
# MySQL:  mysql://knowledgebase:knowledgebase@localhost:3306/knowledgebase
# SQLite: sqlite://knowledgebase.db?mode=rwc
